{
    "build":  {
                  "beforeDevCommand":  "",
                  "beforeBuildCommand":  "",
                  "devPath":  "../src",
                  "distDir":  "../src",
                  "withGlobalTauri":  true
              },
    "package":  {
                    "productName":  "Organizer 2.0",
                    "version":  "1.2.0"
                },
    "tauri":  {
                  "systemTray":  {
                                     "iconPath":  "icons/icon.ico",
                                     "iconAsTemplate":  true
                                 },
                  "allowlist":  {
                                    "all":  false,
                                    "clipboard": {
                                        "all": false,
                                        "readText": true,
                                        "writeText": false
                                    },
                                    "shell":  {
                                                  "all":  false,
                                                  "open":  true
                                              },
                                    "dialog":  {
                                                   "all":  true
                                               },
                                    "window":  {
                                                   "all":  false,
                                                   "close":  true,
                                                   "hide":  true,
                                                   "show":  true,
                                                   "maximize":  true,
                                                   "minimize":  true,
                                                   "unmaximize":  true,
                                                   "unminimize":  true,
                                                   "startDragging":  true,
                                                   "setFocus":  true
                                               }
                                },
                  "updater":  {
                                  "active":  false,
                                  "endpoints":  [

                                                ],
                                  "dialog":  false,
                                  "pubkey":  ""
                              },
                  "bundle":  {
                                 "active":  true,
                                 "targets":  "all",
                                 "identifier":  "com.rustfocus.dofus",
                                 "icon":  [
                                              "icons/icon.ico",
                                              "icons/icon.png"
                                          ]
                             },
                  "security":  {
                                   "csp":  null
                               },
                  "windows":  [
                                  {
                                      "fullscreen":  false,
                                      "resizable":  true,
                                      "title":  "Organizer 2.0 - Dofus Window Organizer",
                                      "width":  800,
                                      "height":  700,
                                      "minWidth":  550,
                                      "minHeight":  500
                                  }
                              ]
              }
}